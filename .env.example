# ==============================================================================
# HISAAB POS - Runtime Environment Configuration Template (.env.example)
# ==============================================================================
# IMPORTANT SECURITY RULES:
# 1. Do NOT put real production keys, passwords, or secrets in this file.
# 2. Use environment variables / secret managers for sensitive production config.
# 3. Keep CLIENT-SAFE public values separate from SERVER-ONLY secrets.
# 4. Never expose service-role keys, payment secrets, webhook secrets, or DB creds
#    to frontend JavaScript, public config files, API responses, or logs.
# 5. The Supabase anon key is designed to be public when used correctly with
#    appropriate Row Level Security (RLS) policies. It is NOT a service-role secret.
#
# Environment/config separation (loaded automatically if present, without
# overriding host-provided variables):
#   .env, .env.local
#   + .env.development[.local]  (development)
#   + .env.test[.local]         (test)
#   + .env.production[.local]    (production)
# Local development continues to work without these files (safe defaults apply).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME / APP ENVIRONMENT
# ------------------------------------------------------------------------------
# development | test | production (APP_ENV takes precedence over NODE_ENV)
APP_ENV=development
# NODE_ENV=development
PORT=3000
HTTPS_PORT=3443
# Optional: override server data directory (SaaS/admin JSON stores)
# HISAAB_DATA_DIR=./data

# ------------------------------------------------------------------------------
# 2. PUBLIC CLIENT CONFIG (browser-safe; anon key is public with proper RLS)
# ------------------------------------------------------------------------------
# If set, the server serves /config.js from these env vars (no private values).
# If unset, local development falls back to the existing config.js file.
# SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_public_key
# (VITE_* aliases also supported for compatibility)
# VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ------------------------------------------------------------------------------
# 3. SERVER-ONLY SECRETS (NEVER expose to frontend/public responses/logs)
# ------------------------------------------------------------------------------
# Admin/bootstrap credentials (REQUIRED in production; strong unique values)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change_me_to_a_strong_secret
# ADMIN_NAME=Hisaab Admin
# SUPER_ADMIN_EMAIL=owner@example.com
# SUPER_ADMIN_PASSWORD=change_me_to_a_strong_secret
# SUPER_ADMIN_NAME=Platform Owner

# Payments (Razorpay secrets are server-only)
# RAZORPAY_KEY_ID=rzp_live_or_test_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Used for mock-payment signing in non-production (or explicit mock opt-in)
# PAYMENT_SIGNING_SECRET=change_me_dev_only_secret
# Production safety: mock payments are blocked unless explicitly allowed
# ALLOW_MOCK_PAYMENTS=false

# Supabase privileged credentials (server-side only, if/when used)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here
# DATABASE_URL=postgresql://user:password@host:5432/dbname

